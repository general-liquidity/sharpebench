# Rust build output
/target
# crates/sharpebench-py is excluded from the workspace (pyo3 extension-module), so it
# builds into its own target dir, which the root-anchored rule above does not cover.
/crates/sharpebench-py/target
**/*.rs.bk

# Python build/test scratch from the sharpebench-py binding
__pycache__/
.pytest_cache/
*.pyd
*.so

# Generated WASM JS bindings (run scripts/build-wasm.sh)
/pkg

# Generated mdbook output (run `mdbook build docs/book`)
/docs/book/book

# We intentionally COMMIT Cargo.lock — reproducible scores require a pinned
# dependency graph. (Generate it with `cargo build` on first checkout.)

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/build.log

# LLM-field runs are paid, resumable experiments. Caches, subprocess counters,
# logs, and partial score files stay local; only a complete assembled
# `llm-field.jsonl` may become evidence after the assembler's completeness gate.
paper/evidence/final/llm-cache-*.jsonl
paper/evidence/final/llm-stats/
paper/evidence/final/llm-field-run.log
paper/evidence/final/llm-field-records-*.jsonl
paper/evidence/final/*.partial
